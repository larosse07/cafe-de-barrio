# ==============================================================================
# CAFÉ DE BARRIO - Variables de Entorno Backend (Ejemplo)
# Copia este archivo como .env en backend/ y completa los valores seguros.
# NUNCA subas tu archivo .env al repositorio.
# ==============================================================================

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Base de datos MySQL 8
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cafe_de_barrio
DB_USERNAME=root
DB_PASSWORD=

# Seguridad JWT (genera una clave aleatoria de al menos 64 caracteres en Base64 o hexadecimal)
JWT_SECRET=
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Administrador inicial (se crea de forma segura e idempotente al arrancar)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@cafedebarrio.local
ADMIN_PASSWORD=

# CORS (orígenes permitidos separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:4200
